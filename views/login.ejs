<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>เข้าสู่ระบบ | ลุงบุญมี</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 flex items-center justify-center min-h-screen">
    <div class="w-full max-w-sm bg-slate-900 p-8 rounded-3xl border border-slate-800">
        <h1 class="text-white text-center text-2xl font-bold mb-6">เข้าสู่ระบบ</h1>
        <% if (error) { %>
            <div class="bg-red-500/20 text-red-400 p-3 rounded-xl mb-4 text-center"><%= error %></div>
        <% } %>
        <form action="/api/login" method="POST" class="space-y-4">
            <input type="text" name="username" placeholder="ชื่อผู้ใช้" required class="w-full bg-slate-800 p-4 rounded-xl text-white outline-none">
            <input type="password" name="password" placeholder="รหัสผ่าน" required class="w-full bg-slate-800 p-4 rounded-xl text-white outline-none">
            <button type="submit" class="w-full bg-amber-500 py-4 rounded-xl font-bold">เข้าสู่ระบบ</button>
        </form>
    </div>
</body>
</html>