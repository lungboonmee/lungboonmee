<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เข้าสู่ระบบ | ลุงบุญมี รับเหมา</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>body { font-family: 'Kanit', sans-serif; background-color: #020617; }</style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 p-8 rounded-[2rem] shadow-2xl">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-amber-500 mb-2">ลุงบุญมี รับเหมา</h1>
            <p class="text-slate-400">เข้าสู่ระบบจัดการงานหลังบ้าน</p>
        </div>
        
        <% if (locals.error) { %>
            <div class="mb-6 p-4 bg-red-900/30 border border-red-500/50 text-red-400 rounded-xl text-sm text-center">
                <%= error %>
            </div>
        <% } %>
        
        <form action="/api/login" method="POST" class="space-y-6">
            <div>
                <label class="block text-sm text-slate-400 mb-2">ชื่อผู้ใช้</label>
                <input type="text" name="username" required class="w-full bg-slate-800 border border-slate-700 rounded-xl p-4 text-white focus:border-amber-500 outline-none transition-all">
            </div>
            <div>
                <label class="block text-sm text-slate-400 mb-2">รหัสผ่าน</label>
                <input type="password" name="password" required class="w-full bg-slate-800 border border-slate-700 rounded-xl p-4 text-white focus:border-amber-500 outline-none transition-all">
            </div>
            <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold py-4 rounded-xl text-lg transition-all shadow-xl hover:shadow-amber-500/20">
                เข้าสู่ระบบ
            </button>
        </form>
        
        <div class="mt-8 text-center">
            <a href="/" class="text-slate-500 text-sm hover:text-amber-500 transition-colors">← กลับหน้าหลัก</a>
        </div>
    </div>
</body>
</html>