<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - ระบบจัดการงานรับเหมาลุงบุญมี</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>แผงควบคุม (Admin Dashboard)</h1>
        <nav>
            <a href="/">หน้าแรก</a>
            <a href="/admin">เพิ่มงานใหม่</a>
        </nav>
    </header>

    <main>
        <section>
            <h2>รายการงานทั้งหมด</h2>
            <table>
                <thead>
                    <tr>
                        <th>วันที่</th>
                        <th>ชื่องาน / ลูกค้า</th>
                        <th>สถานะ</th>
                        <th>การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- ข้อมูลจะถูกส่งมาจาก server.cjs -->
                    <% if (jobs && jobs.length > 0) { %>
                        <% jobs.forEach(function(job) { %>
                            <tr>
                                <td><%= job.created_at ? new Date(job.created_at).toLocaleDateString('th-TH') : '-' %></td>
                                <td><%= job.title %></td>
                                <td><span class="status-badge"><%= job.status || 'รอดำเนินการ' %></span></td>
                                <td>
                                    <button onclick="alert('ฟีเจอร์แก้ไขกำลังพัฒนาครับลุง')">แก้ไข</button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align:center;">ยังไม่มีข้อมูลงานในระบบครับ</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 ระบบจัดการงานรับเหมาลุงบุญมี - Node.js + Supabase</p>
    </footer>
</body>
</html>