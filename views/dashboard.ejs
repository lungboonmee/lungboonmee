<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบจัดการงานหลังบ้าน — ลุงบุญมี รับเหมา</title>
    
    <!-- 🌟 เรียกใช้งานคลังสคริปต์ Quill Editor เวอร์ชันเสถียรมาตรฐานสากลตัวจริง ปลุกช่องกรอกข้อมูล -->
    <link href="https://jsdelivr.net" rel="stylesheet">
    <script src="https://jsdelivr.net"></script>
    
    <style>
        /* ==========================================================================
           💎 BOONMEE PREMIUM ADMIN CSS (ล้างบั๊กไวยากรณ์ปีกกาบรรทัด 220 ออก 100% เพื่อ PROBLEMS = 0)
           ========================================================================== */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif, "Noto Sans Thai"; background-color: #f1f5f9; color: #0f172a; line-height: 1.6; padding-bottom: 60px; display: none; } 
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .top-bar { height: 6px; background-color: #0f172a; width: 100%; }

        /* แถบนำทาง Navbar */
        nav { background-color: #0f172a; padding: 18px 0; border-bottom: 1px solid #1e293b; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15); position: sticky; top: 0; z-index: 100; }
        .nav-container { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .nav-title { font-size: 16px; font-weight: bold; color: #f59e0b; letter-spacing: 0.5px; }
        .nav-right { display: flex; align-items: center; gap: 15px; font-size: 13px; color: #94a3b8; }
        .logout-btn { padding: 8px 18px; background-color: #ef4444; border-radius: 20px; color: #ffffff; text-decoration: none; font-weight: bold; transition: 0.3s; cursor: pointer; border: none; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2); }
        .logout-btn:hover { background-color: #dc2626; transform: translateY(-1px); }

        /* แผงสรุปสถิติมูลค่างาน */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin: 30px 0; }
        .stat-card { background-color: #ffffff; border: 1px solid #cbd5e1; padding: 22px; border-radius: 16px; box-shadow: 0 6px 16px rgba(15, 23, 42, 0.04); transition: 0.3s; }
        .stat-card:hover { box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08); }
        .stat-card .label { font-size: 11px; font-weight: bold; color: #64748b; text-transform: uppercase; }
        .stat-card .value { font-size: 26px; font-weight: 800; color: #0f172a; margin-top: 6px; }
        .stat-card .value.revenue { color: #059669; }

        .admin-heading { font-size: 24px; font-weight: 800; color: #0f172a; margin: 40px 0 20px 0; padding-bottom: 10px; border-bottom: 2px solid #cbd5e1; }

        /* รายการการ์ดคิวงาน */
        .job-list { margin-bottom: 50px; }
        .job-item { display: flex; justify-content: space-between; align-items: center; padding: 24px; background-color: #ffffff; border-radius: 20px; margin-bottom: 16px; color: #1e293b; box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06); border: 1px solid #cbd5e1; transition: 0.3s; gap: 20px; }
        .job-item:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12); border-color: #2563eb; }
        .job-info-side { display: flex; flex-direction: column; gap: 6px; flex: 1; text-align: left; }
        .job-status-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
        .job-title-text { font-size: 19px; font-weight: bold; color: #0f172a; }
        .job-customer-text { font-size: 13.5px; color: #475569; font-weight: 600; }
        
        .job-comment-preview { font-size: 12.5px; color: #1e40af; background-color: #eff6ff; padding: 10px 14px; border-radius: 10px; border: 1px dashed #bfdbfe; margin-top: 6px; font-weight: 600; width: 100%; max-width: max-content; }
        .job-action-side { display: flex; align-items: center; gap: 14px; justify-content: flex-end; flex-shrink: 0; }
        
        .btn-manage-job { background-color: #0f172a; color: #ffffff; font-weight: bold; padding: 12px 24px; border-radius: 20px; border: none; cursor: pointer; font-size: 13px; transition: 0.3s; box-shadow: 0 4px 10px rgba(15,23,42,0.15); font-family: inherit; }
        .btn-manage-job:hover { background-color: #1e293b; transform: translateY(-1px); }

        .status-select { background-color: #f1f5f9; border: 1px solid #cbd5e1; color: #0f172a; padding: 10px 14px; border-radius: 10px; font-size: 12.5px; font-weight: bold; outline: none; cursor: pointer; font-family: inherit; transition: 0.2s; }
        .status-select:focus { border-color: #2563eb; background-color: #ffffff; }

        .badge { padding: 6px 14px; font-size: 11px; font-weight: bold; border-radius: 6px; display: inline-flex; align-items: center; letter-spacing: 0.5px; }
        .badge-pending { background-color: #fef3c7; color: #d97706; border: 1px solid #fcd34d; }
        .badge-progress { background-color: #dbeafe; color: #2563eb; border: 1px solid #93c5fd; }
        .badge-completed { background-color: #d1fae5; color: #059669; border: 1px solid #6ee7b7; }
        .badge-member { background-color: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd; font-weight: bold; }

        .announcement-panel { background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 24px; padding: 30px; margin-top: 40px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05); }
        .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #cbd5e1; gap: 15px; }
        .panel-header h3 { font-size: 18px; color: #0f172a; font-weight: bold; }
        .btn-create-ann { background-color: #2563eb; color: #ffffff; font-weight: bold; padding: 10px 22px; border-radius: 12px; border: none; cursor: pointer; font-size: 12.5px; transition: 0.3s; box-shadow: 0 4px 12px rgba(37,99,235,0.15); font-family: inherit; }
        .btn-create-ann:hover { background-color: #1d4ed8; transform: translateY(-0.5px); }

        .ann-table { width: 100%; border-collapse: separate; border-spacing: 0; text-align: left; font-size: 13.5px; }
        .ann-table th { padding: 16px 14px; color: #475569; font-weight: bold; background-color: #f8fafc; border-bottom: 1px solid #cbd5e1; }
        .ann-table td { padding: 16px 14px; border-bottom: 1px solid #cbd5e1; color: #334155; font-weight: 500; }
        .ann-table tr:hover td { background-color: #f1f5f9; }
        .text-dark-bold { color: #0f172a; font-weight: bold; }
        .table-badge { padding: 3px 8px; font-size: 10.5px; border-radius: 5px; font-weight: bold; }
        
        .table-btn-edit { color: #2563eb; background: none; border: none; cursor: pointer; font-weight: bold; font-size: 12.5px; margin-right: 14px; font-family: inherit; }
        .table-btn-edit:hover { text-decoration: underline; }
        .table-btn-delete { color: #ef4444; background: none; border: none; cursor: pointer; font-weight: bold; font-size: 12.5px; font-family: inherit; }
        .table-btn-delete:hover { text-decoration: underline; }

        .search-control { padding: 10px 16px; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 12.5px; font-weight: 500; outline: none; width: 100%; max-width: 280px; transition: 0.3s; font-family: inherit; }
        .search-control:focus { border-color: #2563eb; background-color: #ffffff; box-shadow: 0 0 0 3px rgba(37,99,235,0.08); }

        /* ระบบเลเยอร์และโมดอลแบบจัดบาลานซ์ขอบเขตระเบียบ CSS */
        .custom-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(15, 23, 42, 0.6); display: none; align-items: center; justify-content: center; z-index: 200; padding: 20px; backdrop-filter: blur(4px); }
        .custom-modal-box { background-color: #ffffff; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25); width: 100%; max-width: 650px; padding: 35px; border: 1px solid #cbd5e1; }
        
        .editor-wrapper { background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #cbd5e1; min-height: 230px; margin-top: 6px; }
        .ql-toolbar.ql-snow { background-color: #f8fafc; border: none !important; border-bottom: 1px solid #cbd5e1 !important; }
        .ql-container.ql-snow { border: none !important; min-height: 180px; font-size: 14px; background-color: #ffffff; }
        .ql-editor { min-height: 180px; cursor: text !important; }

        .modal-title-area { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #cbd5e1; padding-bottom: 16px; margin-bottom: 24px; }
        .modal-form-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
        .modal-form-group label { font-size: 13px; font-weight: bold; color: #0f172a; }
        .modal-textarea { width: 100%; padding: 14px; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 13.5px; outline: none; font-family: inherit; resize: vertical; transition: 0.2s; }
        .modal-textarea:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.08); }
        .modal-input-text { width: 100%; padding: 14px; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 14px; outline: none; transition: 0.2s; font-family: inherit; font-weight: 500; }
        .modal-input-text:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.08); }
        .modal-btn-group { display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; }
        .modal-btn-cancel { padding: 10px 22px; background-color: #f1f5f9; border-radius: 20px; color: #475569; font-size: 13px; font-weight: bold; border: 1px solid #cbd5e1; cursor: pointer; font-family: inherit; transition: 0.2s; }
        .modal-btn-cancel:hover { background-color: #e2e8f0; }
        .modal-btn-confirm { padding: 10px 24px; background-color: #0f172a; border-radius: 20px; color: #ffffff; font-size: 13px; font-weight: bold; border: none; cursor: pointer; font-family: inherit; transition: 0.2s; }
        .modal-btn-confirm:hover { background-color: #1e293b; }
        .modal-btn-confirm.blue { background-color: #2563eb; }
        .modal-btn-confirm.blue:hover { background-color: #1d4ed8; }

        footer { text-align: center; padding: 40px 0; color: #94a3b8; font-size: 12px; border-top: 1px solid #cbd5e1; margin-top: 60px; font-weight: 600; }
    </style>
</head>
<body>
    <div class="top-bar"></div>
    <nav>
        <div class="nav-container">
            <div class="nav-title">ระบบจัดการงานหลังบ้าน — ลุงบุญมี รับเหมา</div>
            <div class="nav-right">
                <span>สวัสดี ลุงบุญมี</span>
                <button onclick="logout()" class="logout-btn">ออกจากระบบ</button>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- แผงสถิติสรุปภาพรวมจำนวนงาน -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="label">งานทั้งหมดในคิว</div>
                <div class="value"><%= (typeof jobsSummary !== 'undefined') ? jobsSummary.all.length : 0 %> งาน</div>
            </div>
            <div class="stat-card">
                <div class="label">⏳ กำลังรอคิว</div>
                <div class="value" style="color: #d97706;"><%= (typeof jobsSummary !== 'undefined') ? jobsSummary.pending.length : 0 %> งาน</div>
            </div>
            <div class="stat-card">
                <div class="label">⚡ กำลังดำเนินการ</div>
                <div class="value" style="color: #2563eb;"><%= (typeof jobsSummary !== 'undefined') ? jobsSummary.inProgress.length : 0 %> งาน</div>
            </div>
            <div class="stat-card">
                <div class="label">💰 ยอดเงินจบงานแล้ว</div>
                <% 
                    let revenueSum = 0; 
                    if(typeof jobsSummary !== 'undefined') {
                        jobsSummary.completed.forEach(j => revenueSum += (Number(j.price) || 0));
                    }
                %>
                <div class="value revenue">฿<%= revenueSum.toLocaleString('th-TH') %></div>
            </div>
        </section>

        <div class="admin-heading">รายการแจ้งงานล่าสุด</div>
        <div class="job-list">
            <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                <% jobs.forEach(function(job) { %>
                    <% 
                        let statusClean = (job.status || '').toLowerCase().trim();
                        let thaiStatusLabel = 'รอดำเนินการ';
                        let badgeClass = 'badge-pending';
                        
                        if (statusClean === 'in-progress' || statusClean === 'in_progress' || statusClean === 'กำลังดำเนินการ' || statusClean === 'กำลังทำ') {
                            thaiStatusLabel = 'กำลังดำเนินการ';
                            badgeClass = 'badge-progress';
                        } else if (statusClean === 'completed' || statusClean === 'เสร็จสิ้นการดำเนินการ' || statusClean === 'เสร็จสิ้น' || statusClean === 'เสร็จงาน') {
                            thaiStatusLabel = 'เสร็จสิ้น';
                            badgeClass = 'badge-completed';
                        }
                        let displayPhone = job.phone || job.customer_phone || '-';
                    %>
                    <div class="job-item">
                        <div class="job-info-side">
                            <div class="job-status-row">
                                <span class="badge <%= badgeClass %>">
                                    <%= thaiStatusLabel %>
                                </span>
                                <% if (job.is_member === true || job.is_member === 'true') { %>
                                    <span class="badge badge-member">MEMBER</span>
                                <% } %>
                            </div>
                            <div class="job-title-text"><%= job.detail || 'ซ่อมแซมต่อเติมโครงสร้างอาคาร' %></div>
                            <div class="job-customer-text">ผู้แจ้งงาน: คุณ <%= job.customer_name %> | เบอร์ติดต่อ: <%= displayPhone %></div>
                            <div class="job-comment-preview">
                                บันทึกความเห็นความคืบหน้าล่าสุด: <%= job.last_comment || 'ช่างกำลังเตรียมจัดทีมงานเข้าเริ่มกระบวนการครับ' %>
                            </div>
                        </div>
                        <div class="job-action-side">
                            <select id="card-select-<%= job.id %>" class="status-select">
                                <option value="Pending" <%= (statusClean === 'pending' || statusClean === 'กำลังรอคิว' || statusClean === 'รอดำเนินการ') ? 'selected' : '' %>>รอดำเนินการ (Pending)</option>
                                <option value="In-Progress" <%= (statusClean === 'in-progress' || statusClean === 'in_progress' || statusClean === 'กำลังดำเนินการ' || statusClean === 'กำลังทำ') ? 'selected' : '' %>>กำลังดำเนินการ (In-Progress)</option>
                                <option value="Completed" <%= (statusClean === 'completed' || statusClean === 'เสร็จสิ้นการดำเนินการ' || statusClean === 'เสร็จสิ้น' || statusClean === 'เสร็จงาน') ? 'selected' : '' %>>เสร็จสิ้นโครงการ (Completed)</option>
                            </select>
                            <button onclick="openStatusModal('<%= job.id %>', 'card-select-<%= job.id %>', '<%= job.customer_name %>')" class="btn-manage-job">จัดการงาน / อัปเดตแก้ไข</button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div style="text-align: center; color: #94a3b8; padding: 40px 0; background-color: #ffffff; border-radius: 20px; border: 1px solid #cbd5e1; font-weight: 500; font-size: 14px;">ยังไม่มีข้อมูลรายการแจ้งงานเข้ามาในระบบขณะนี้ครับลุง</div>
            <% } %>
        </div>

        <!-- 📢 ระบบจัดการข่าวประกาศและกิจกรรมหน้าร้าน -->
        <div class="announcement-panel">
            <div class="panel-header">
                <h3>📢 ระบบจัดการข่าวประกาศและกิจกรรมหน้าร้าน</h3>
                <button onclick="openNewsModal()" class="btn-create-ann">+ เพิ่มประกาศใหม่</button>
            </div>
            <table class="ann-table">
                <thead><tr><th>หัวข้อข่าวประกาศ</th><th>รายละเอียดเนื้อหา</th><th>สถานะ</th><th style="text-align: center;">ตัวเลือก</th></tr></thead>
                <tbody>
                    <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
                        <% announcements.forEach(function(item) { %>
                            <tr class="ann-row" data-id="<%= item.id %>" data-active="<%= item.is_active %>">
                                <td class="text-dark-bold ann-title-cell" style="max-width: 200px; word-break: break-word;"><%= item.title %></td>
                                <td class="ann-content-cell" style="max-width: 350px; word-break: break-word;">
                                    <div style="max-height: 80px; overflow: hidden; text-overflow: ellipsis;">
                                        <%- item.content %>
                                    </div>
                                </td>
                                <td>
                                    <span class="table-badge" style="<%= item.is_active ? 'background-color: #d1fae5; color:#059669;' : 'background-color: #f1f5f9; color:#64748b;' %>">
                                        <%= item.is_active ? 'เปิดแสดง' : 'ปิดซ่อน' %>
                                    </span>
                                </td>
                                <td style="text-align: center; white-space: nowrap;">
                                    <button class="table-btn-edit" onclick="openEditNewsModalByRow(this)">แก้ไขข้อมูล</button>
                                    <button class="table-btn-delete" onclick="deleteAnnouncement('<%= item.id %>')">ลบ</button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="4" style="text-align: center; color: #94a3b8; padding: 20px 0;">ไม่มีข้อมูลประกาศข่าวสารหน้าร้านในขณะนี้...</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- 👥 รายชื่อระบบฐานข้อมูลสมาชิก -->
        <div class="announcement-panel" style="margin-top: 40px; margin-bottom: 60px;">
            <div class="panel-header">
                <h3>👥 รายชื่อระบบฐานข้อมูลสมาชิก</h3>
                <input type="text" id="member-search-input" onkeyup="filterMembers()" placeholder="🔎 พิมพ์ค้นหา ชื่อสมาชิก หรือ เบอร์โทร..." class="search-control">
            </div>
            <table class="ann-table" id="member-data-table">
                <thead><tr><th>ชื่อสมาชิก</th><th>เบอร์โทรศัพท์</th><th>วันที่สมัครคิวงาน</th><th style="text-align: center;">ตัวเลือก</th></tr></thead>
                <tbody>
                    <% 
                        let memberCount = 0;
                        if (typeof jobs !== 'undefined' && jobs.length > 0) { 
                            jobs.forEach(function(job) { 
                                if(job.is_member === true || job.is_member === 'true') {
                                    memberCount++;
                                    let displayMPhone = job.phone || job.customer_phone || '-';
                    %>
                                    <tr class="member-row" data-phone="<%= displayMPhone %>">
                                        <td class="text-dark-bold name-cell">คุณ <%= job.customer_name %></td>
                                        <td class="phone-cell"><%= displayMPhone %></td>
                                        <td><%= new Date(job.created_at).toLocaleDateString('th-TH') %></td>
                                        <td style="text-align: center;">
                                            <button onclick="openStatusModal('<%= job.id %>', 'card-select-<%= job.id %>', '<%= job.customer_name %>')" class="table-btn-edit">อัปเดตคิวงานสมาชิก</button>
                                        </td>
                                    </tr>
                    <% 
                                }
                            }); 
                        } 
                        if(memberCount === 0) {
                    %>
                        <tr><td colspan="4" style="text-align: center; color: #94a3b8; padding: 20px 0;">ยังไม่มีรายชื่อลูกค้าสมัครสมาชิกเข้ามาในตารางคิวงานครับลุง</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <!-- 🛠️ กล่องป๊อปอัปกรอกบันทึกความคืบหน้า (Modal งาน) -->
    <div id="status-modal" class="custom-modal-overlay">
        <div class="custom-modal-box" style="max-width: 500px;">
            <div class="modal-title-area">
                <div>
                    <h3 style="font-size: 16px; font-weight: bold; color: #0f172a;">บันทึกความคืบหน้าแจ้งสมาชิก</h3>
                    <p id="modal-job-title" style="font-size: 12px; color: #64748b; margin-top: 4px;">ลูกค้า: -</p>
                </div>
                <button type="button" onclick="closeStatusModal()" style="background: none; border: none; font-size: 18px; color: #94a3b8; cursor: pointer;">✕</button>
            </div>
            <form id="modal-status-form" onsubmit="event.preventDefault();">
                <input type="hidden" id="modal-job-id">
                <input type="hidden" id="modal-status-value">
                <div style="margin-bottom: 16px;">
                    <p style="font-size: 13px; font-weight: 600; color: #334155;">สถานะคิวงานที่จะเปลี่ยน: <span id="modal-status-preview" style="color: #2563eb; font-weight: bold;">-</span></p>
                </div>
                <div class="modal-form-group">
                    <label>กรอกบันทึก / ข้อความความเห็นประกอบความคืบหน้า</label>
                    <textarea id="modal-comment-input" rows="4" placeholder="พิมพ์รายละเอียดความคืบหน้าแจ้งให้ลูกค้าเห็นที่หน้าแรก..." class="modal-textarea" required></textarea>
                </div>
                <div class="modal-btn-group">
                    <button type="button" onclick="closeStatusModal()" class="modal-btn-cancel">ยกเลิก</button>
                    <button type="submit" class="modal-btn-confirm">บันทึกและส่งอัปเดต</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 📢 กล่องป๊อปอัปเพิ่ม/แก้ไขข่าวประกาศ (Rich Text Quill Modal) -->
    <div id="news-modal" class="custom-modal-overlay">
        <div class="custom-modal-box">
            <div class="modal-title-area">
                <div>
                    <h3 style="font-size: 18px; font-weight: 800; color: #0f172a;" id="news-modal-heading">📢 เพิ่มข่าวประกาศใหม่</h3>
                    <p style="font-size: 12px; color: #64748b; margin-top: 4px;">เขียนแจ้งข้อมูลข่าวสาร อัปเดตราคา หรือแจ้งวันหยุดให้ลูกค้าทราบที่หน้าแรก</p>
                </div>
                <button type="button" onclick="closeNewsModal()" style="background: none; border: none; font-size: 20px; color: #94a3b8; cursor: pointer; font-weight: bold; padding: 4px;">✕</button>
            </div>
            <form id="modal-news-form" onsubmit="event.preventDefault();">
                <input type="hidden" id="modal-news-id">
                <input type="hidden" id="modal-news-mode" value="create">
                <div class="modal-form-group">
                    <label>หัวข้อข่าวประกาศ (ใส่คำโปรยและอิโมจิให้สะดุดตา)</label>
                    <input type="text" id="news-title-input" placeholder="ตัวอย่าง: 📢 แจ้งวันหยุดสงกรานต์ช่างลุงบุญมี..." class="modal-input-text" required>
                    <div style="display: flex; gap: 6px; margin-top: 4px; flex-wrap: wrap;">
                        <span style="font-size: 11px; color: #64748b; font-weight: bold; align-self: center;">ทางลัดหัวข้อ:</span>
                        <button type="button" style="padding: 3px 8px; background-color: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 11px; cursor: pointer; font-weight: bold;" onclick="insertEmojiToTitle('📢')">📢 ประกาศ</button>
                        <button type="button" style="padding: 3px 8px; background-color: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 11px; cursor: pointer; font-weight: bold;" onclick="insertEmojiToTitle('👷‍♂️')">👷‍♂️ ช่าง VIP</button>
                        <button type="button" style="padding: 3px 8px; background-color: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 11px; cursor: pointer; font-weight: bold;" onclick="insertEmojiToTitle('🛠️')">🛠️ วิศวกรรม</button>
                        <button type="button" style="padding: 3px 8px; background-color: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 11px; cursor: pointer; font-weight: bold;" onclick="insertEmojiToTitle('💎')">💎 พรีเมียม</button>
                        <button type="button" style="padding: 3px 8px; background-color: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 20px; font-size: 11px; cursor: pointer; font-weight: bold;" onclick="insertEmojiToTitle('✅')">✅ เสร็จสิ้น</button>
                    </div>
                </div>
                <div class="modal-form-group">
                    <label>รายละเอียดเนื้อหาข่าวสาร (จัดแต่งตัวหนา ตัวเอียง หรือทำรายการลิสต์ได้เต็มที่)</label>
                    <div class="editor-wrapper">
                        <div id="news-editor"></div>
                    </div>
                </div>
                <div id="news-status-toggle-box" style="margin-bottom: 24px; background-color: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #e2e8f0; display: none;">
                    <label style="display: flex; align-items: center; gap: 10px; font-size: 13.5px; font-weight: bold; color: #334155; cursor: pointer;">
                        <input type="checkbox" id="news-active-input" checked style="width: 18px; height: 18px; accent-color: #2563eb;">
                        เปิดการแสดงผลประกาศนี้ที่หน้าหลักโปรเจกต์
                    </label>
                </div>
                <div class="modal-btn-group">
                    <button type="button" onclick="closeNewsModal()" class="modal-btn-cancel">ยกเลิก</button>
                    <button type="submit" class="modal-btn-confirm blue" id="news-submit-btn">เผยแพร่ข่าวประกาศ</button>
                </div>
            </form>
        </div>
    </div>

    <footer><p>© 2026 ลุงบุญมี รับเหมา — PORTAL v2</p></footer>

    <script>
        window.newsEditor = null;

        if (localStorage.getItem('adminToken') !== 'boonmee_secret_luxury_token_2026') {
            window.location.href = '/login';
        } else {
            document.body.style.display = 'block'; 
        }

        function logout() {
            localStorage.removeItem('adminToken');
            alert('🔒 ปิดเซสชันการเชื่อมต่อระบบแดชบอร์ดเรียบร้อยแล้วค่ะ');
            window.location.href = '/login';
        }

        function insertEmojiToTitle(emoji) {
            const titleInput = document.getElementById('news-title-input');
            if (titleInput) {
                const startPos = titleInput.selectionStart;
                const endPos = titleInput.selectionEnd;
                const text = titleInput.value;
                
                titleInput.value = text.substring(0, startPos) + emoji + text.substring(endPos);
                titleInput.focus();
                titleInput.selectionStart = titleInput.selectionEnd = startPos + emoji.length;
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            if (document.getElementById('news-editor')) {
                window.newsEditor = new Quill('#news-editor', {
                    theme: 'snow',
                    placeholder: 'คลิกพิมพ์รังสรรค์รายละเอียดข่าวประกาศ กิจกรรมแต่งบ้านหรู หรือรายละเอียดวัสดุพรีเมียมที่นี่ได้เลยครับลุง...',
                    modules: {
                        toolbar: [
                            ['bold', 'italic', 'underline'], 
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }], 
                            ['clean'] 
                        ]
                    }
                });
            }
        });

        function openStatusModal(jobId, selectElementId, customerName) {
            const displayStatus = document.getElementById(selectElementId).value;
            document.getElementById('modal-job-id').value = jobId;
            document.getElementById('modal-status-value').value = displayStatus;
            
            const previewElement = document.getElementById('modal-status-preview');
            previewElement.innerText = displayStatus;
            
            if (displayStatus === 'In-Progress') {
                previewElement.innerText = 'กำลังดำเนินการ (In-Progress)';
                previewElement.style.color = '#2563eb';
            } else if (displayStatus === 'Completed') {
                previewElement.innerText = 'เสร็จสิ้นโครงการ (Completed)';
                previewElement.style.color = '#059669';
            } else {
                previewElement.innerText = 'รอดำเนินการ (Pending)';
                previewElement.style.color = '#d97706';
            }
            
            document.getElementById('modal-job-title').innerText = `เจ้าของโครงการ: คุณ ${customerName}`;
            document.getElementById('modal-comment-input').value = ''; 
            document.getElementById('status-modal').style.display = 'flex';
        }
        
        function closeStatusModal() { 
            document.getElementById('status-modal').style.display = 'none'; 
        }

        document.getElementById('modal-status-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const confirmBtn = e.target.querySelector('.modal-btn-confirm');
            const originalBtnText = confirmBtn.innerText;
            
            const jobId = document.getElementById('modal-job-id').value;
            const webStatus = document.getElementById('modal-status-value').value.trim();
            const comment = document.getElementById('modal-comment-input').value;

            let dbStatus = 'Pending';
            if (webStatus === 'In-Progress' || webStatus === 'กำลังดำเนินการ' || webStatus === 'กำลังทำ') {
                dbStatus = 'In-Progress';
            } else if (webStatus === 'Completed' || webStatus === 'เสร็จสิ้น' || webStatus === 'เสร็จงาน') {
                dbStatus = 'Completed';
            }

            confirmBtn.innerText = 'กำลังอัปเดตข้อมูล...';
            confirmBtn.disabled = true;

            try {
                const response = await fetch('/api/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ jobId: jobId, newStatus: dbStatus, comment: comment })
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    alert('✨ ดำเนินการอัปเดตสถานะคิวงาน และส่งบันทึกรายงานสำเร็จเรียบร้อยแล้วค่ะ');
                    closeStatusModal();
                    window.location.href = window.location.pathname + '?refresh=' + Date.now();
                } else { 
                    alert('ระบบหลังบ้านปฏิเสธการอัปเดตข้อมูล: ' + (result.message || 'Error 500')); 
                }
            } catch (error) { 
                alert('เกิดข้อผิดพลาดในการเชื่อมต่อเครือข่ายสัญญาณ'); 
            } finally {
                confirmBtn.innerText = originalBtnText;
                confirmBtn.disabled = false;
            }
        });

        function initializeQuillEditor(initialHTML = '') {
            const wrapper = document.querySelector('.editor-wrapper');
            if (wrapper) {
                wrapper.innerHTML = '<div id="news-editor"></div>';
            }
            
            window.newsEditor = new Quill('#news-editor', {
                theme: 'snow',
                placeholder: 'คลิกพิมพ์รายละเอียดข่าวประกาศ กิจกรรมแต่งบ้านหรู หรือรายละเอียดวัสดุพรีเมียมที่นี่ได้เลยครับลุงบุญมี...',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline'], 
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }], 
                        ['clean'] 
                    ]
                }
            });

            if (initialHTML !== '') {
                window.newsEditor.clipboard.dangerouslyPasteHTML(0, initialHTML.trim());
            }
            
            window.newsEditor.enable(true);
            window.newsEditor.focus();
        }

        function openNewsModal() {
            document.getElementById('modal-news-mode').value = 'create';
            document.getElementById('news-modal-heading').innerText = '📢 เพิ่มข่าวประกาศใหม่';
            document.getElementById('news-title-input').value = '';
            document.getElementById('news-status-toggle-box').style.display = 'none';
            document.getElementById('news-submit-btn').innerText = 'เผยแพร่ข่าวประกาศ';
            
            document.getElementById('news-modal').style.display = 'flex';
            
            setTimeout(() => {
                initializeQuillEditor('');
            }, 100);
        }

        function openEditNewsModalByRow(buttonElement) {
            const row = buttonElement.closest('.ann-row');
            const id = row.getAttribute('data-id');
            const isActive = row.getAttribute('data-active') === 'true';
            const title = row.querySelector('.ann-title-cell').textContent.trim();
            
            const contentCell = row.querySelector('.ann-content-cell');
            const innerContainer = contentCell.querySelector('div') || contentCell;
            const contentHTML = innerContainer.innerHTML;

            document.getElementById('modal-news-mode').value = 'edit';
            document.getElementById('modal-news-id').value = id;
            document.getElementById('news-modal-heading').innerText = '📝 แก้ไขข่าวประกาศ';
            document.getElementById('news-title-input').value = title;
            document.getElementById('news-status-toggle-box').style.display = 'block';
            document.getElementById('news-submit-btn').innerText = 'บันทึกการแก้ไข';
            
            document.getElementById('news-modal').style.display = 'flex';
            
            setTimeout(() => {
                initializeQuillEditor(contentHTML);
            }, 100);
        }

        function closeNewsModal() { 
            document.getElementById('news-modal').style.display = 'none'; 
        }

        document.getElementById('modal-news-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = document.getElementById('news-submit-btn');
            const originalBtnText = submitBtn.innerText;
            const mode = document.getElementById('modal-news-mode').value;
            const title = document.getElementById('news-title-input').value.trim();
            
            let content = '';
            if (window.newsEditor) {
                content = window.newsEditor.root.innerHTML.trim(); 
            }

            if (!content || content === '<p><br></p>' || content === '') {
                alert('⚠️ กรุณากรอกรายละเอียดเนื้อหาข่าวประกาศในกล่องข้อความก่อนกดเผยแพร่ค่ะ');
                return;
            }
            
            let url = '/api/announcements';
            let payload = { title: title, content: content };

            if (mode === 'edit') {
                url = '/api/announcements/edit';
                payload = {
                    ...payload,
                    id: document.getElementById('modal-news-id').value,
                    is_active: document.getElementById('news-active-input').checked
                };
            }

            submitBtn.innerText = 'กำลังส่งข้อมูลบันทึก...';
            submitBtn.disabled = true;

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    alert('✨ ดำเนินการอัปเดตระบบข่าวประกาศหน้าร้านเรียบร้อยแล้วครับลุงบุญมี!');
                    closeNewsModal();
                    window.location.href = window.location.pathname + '?refresh=' + Date.now();
                } else { 
                    alert('เซิร์ฟเวอร์ปฏิเสธคำขอ: ' + (result.error || 'Error 500')); 
                }
            } catch (error) { 
                alert('เครือข่ายขัดข้อง ไม่สามารถเชื่อมต่อระบบหลักโครงการได้ในขณะนี้'); 
            } finally {
                submitBtn.innerText = originalBtnText;
                submitBtn.disabled = false;
            }
        });

        async function deleteAnnouncement(id) {
            if (!id) return;
            if (!confirm("🔒 คุณลุงแน่ใจนะคะว่าต้องการลบข้อมูลประกาศชิ้นนี้ถาวร? ย้อนคืนไม่ได้แล้วนะครับ")) return;
            try {
                const res = await fetch('/api/announcements/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: id })
                });
                const result = await res.json();
                if (res.ok && result.success) {
                    alert('✨ ลบข้อมูลประกาศเรียบร้อยแล้วครับ');
                    window.location.href = window.location.pathname + '?refresh=' + Date.now();
                } else {
                    alert('ระบบหลังบ้านปฏิเสธคำขอลบข้อมูล');
                }
            } catch (error) {
                alert('เครือข่ายขัดข้อง ไม่สามารถติดต่อระบบคลังข้อมูลได้ค่ะ');
            }
        }

        function filterMembers() {
            const searchInput = document.getElementById('member-search-input');
            if (!searchInput) return;
            const keyword = searchInput.value.toLowerCase().trim();
            const rows = document.getElementsByClassName('member-row');
            for (let i = 0; i < rows.length; i++) {
                const nameCell = rows[i].querySelector('.name-cell');
                const phoneCell = rows[i].querySelector('.phone-cell');
                if (nameCell && phoneCell) {
                    const nameText = nameCell.textContent.toLowerCase();
                    const rawPhoneData = rows[i].getAttribute('data-phone') || '';
                    const phoneText = rawPhoneData !== '' ? rawPhoneData.toLowerCase() : phoneCell.textContent.toLowerCase();
                    if (nameText.includes(keyword) || phoneText.includes(keyword)) {
                        rows[i].style.display = ""; 
                    } else {
                        rows[i].style.display = "none"; 
                    }
                }
            }
        }
    </script>
</body>
</html>
