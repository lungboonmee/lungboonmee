<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แผงควบคุมระบบ | ลุงบุญมี</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>body { font-family: 'Kanit', sans-serif; background-color: #f8fafc; }</style>
</head>
<body class="bg-slate-50">
    <nav class="bg-slate-900 text-white p-4 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold text-amber-500">ระบบจัดการงานหลังบ้าน</h1>
            <div class="flex items-center gap-4">
                <span class="text-sm opacity-70">สวัสดี ลุงบุญมี</span>
                <a href="/logout" class="bg-red-500/20 hover:bg-red-500 text-red-200 hover:text-white px-4 py-2 rounded-lg text-sm transition">ออกจากระบบ</a>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto py-10 px-4">
        <h2 class="text-2xl font-bold mb-6 text-slate-800">รายการแจ้งงานล่าสุด</h2>
        
        <div class="grid grid-cols-1 gap-4">
            <% if (jobs && jobs.length > 0) { %>
                <% jobs.forEach(job => { %>
                    <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm hover:shadow-md transition flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <div class="flex items-center gap-3 mb-2">
                                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase 
                                    <%= job.status === 'Pending' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700' %>">
                                    <%= job.status %>
                                </span>
                                <% if(job.is_member) { %>
                                    <span class="text-[10px] bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded font-bold">MEMBER</span>
                                <% } %>
                            </div>
                            <h3 class="text-lg font-bold text-slate-900"><%= job.detail %></h3>
                            <p class="text-sm text-slate-500">ลูกค้า: <%= job.customer_name %> | 📞 <%= job.phone %></p>
                        </div>
                        <div class="flex gap-2">
                            <a href="/admin?id=<%= job.id %>" class="bg-slate-900 text-white px-6 py-2 rounded-xl text-sm font-semibold hover:bg-slate-800">
                                จัดการงาน/อัปเดตรูป
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="text-center py-20 bg-white rounded-3xl border-2 border-dashed border-slate-200">
                    <p class="text-slate-400 font-light text-lg">ยังไม่มีรายการแจ้งงานเข้ามาครับลุง</p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>