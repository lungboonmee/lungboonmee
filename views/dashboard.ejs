<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>หลังบ้านลุงบุญมี</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">Dashboard ลุงบุญมี</a>
            <a href="/logout" class="btn btn-outline-light btn-sm">ออกจากระบบ</a>
        </div>
    </nav>

    <div class="container">
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ชื่อลูกค้า</th>
                            <th>รายละเอียด</th>
                            <th>สถานะ (เปลี่ยนได้เลย)</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jobs.forEach(job => { %>
                        <tr>
                            <td><strong><%= job.customer_name %></strong></td>
                            <td><%= job.detail %></td>
                            <td>
                                <form action="/api/update-status" method="POST">
                                    <input type="hidden" name="id" value="<%= job.id %>">
                                    <select name="status" onchange="this.form.submit()" class="form-select form-select-sm w-auto">
                                        <option value="Pending" <%= job.status === 'Pending' ? 'selected' : '' %>>รอดำเนินการ</option>
                                        <option value="In Progress" <%= job.status === 'In Progress' ? 'selected' : '' %>>กำลังทำ</option>
                                        <option value="Completed" <%= job.status === 'Completed' ? 'selected' : '' %>>เสร็จสิ้น</option>
                                    </select>
                                </form>
                            </td>
                            <td>
                                <a href="/admin?id=<%= job.id %>" class="btn btn-primary btn-sm">ดูรายละเอียด</a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>