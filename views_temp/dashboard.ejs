<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>พื้นที่สมาชิก - ลุงบุญมี รับเหมา</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Kanit', sans-serif; background-color: #f8fafc; }
        .status-card { transition: transform 0.2s; }
        .status-card:hover { transform: translateY(-5px); }
    </style>
</head>
<body class="text-slate-800">

    <!-- Navigation -->
    <nav class="bg-white shadow-sm py-4 px-6 flex justify-between items-center">
        <div class="text-xl font-bold text-slate-900">ลุงบุญมี <span class="text-amber-500">MEMBER</span></div>
        <div class="flex items-center space-x-4">
            <span class="text-sm text-slate-500">ยินดีต้อนรับ, คุณลูกค้า</span>
            <a href="/" class="text-sm font-semibold text-red-500">ออกจากระบบ</a>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto py-10 px-4">
        <h1 class="text-2xl font-semibold mb-8">รายการแจ้งงานของคุณ</h1>

        <!-- รายการงานของสมาชิก -->
        <div class="space-y-6">
            <% if (myJobs.length === 0) { %>
                <div class="text-center py-20 bg-white rounded-3xl border border-dashed border-slate-300">
                    <p class="text-slate-400">ยังไม่มีรายการแจ้งงานในขณะนี้</p>
                    <a href="/#request-form" class="text-amber-600 font-medium mt-2 inline-block">เริ่มแจ้งงานใหม่</a>
                </div>
            <% } %>

            <% myJobs.forEach(job => { %>
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 status-card">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-xl font-semibold text-slate-900"><%= job.detail %></h3>
                            <p class="text-sm text-slate-400">รหัสงาน: #<%= job.id.toString().slice(-5) %></p>
                        </div>
                        <span class="px-4 py-1 rounded-full text-xs font-bold uppercase
                            <%= job.status === 'Quoted' ? 'bg-amber-100 text-amber-600' : 
                               job.status === 'In-Progress' ? 'bg-blue-100 text-blue-600' : 'bg-slate-100 text-slate-500' %>">
                            <%= job.status === 'Quoted' ? 'รอการยืนยันราคา' : 
                               job.status === 'In-Progress' ? 'กำลังดำเนินการ' : 'รอดำเนินการ' %>
                        </span>
                    </div>

                    <!-- ส่วนแสดงราคาและการตัดสินใจ -->
                    <% if (job.status === 'Quoted') { %>
                        <div class="mt-6 p-5 bg-slate-50 rounded-2xl flex flex-col md:flex-row justify-between items-center gap-4">
                            <div>
                                <p class="text-sm text-slate-500">ราคาประเมินจากลุงบุญมี:</p>
                                <p class="text-2xl font-bold text-slate-900">฿<%= job.price.toLocaleString() %></p>
                            </div>
                            <div class="flex space-x-3 w-full md:w-auto">
                                <form action="/api/member/confirm-price" method="POST" class="flex-1">
                                    <input type="hidden" name="job_id" value="<%= job.id %>">
                                    <input type="hidden" name="action" value="approve">
                                    <button class="w-full bg-slate-900 text-white px-6 py-3 rounded-xl font-semibold hover:bg-slate-800 transition shadow-lg">
                                        ยืนยันราคา
                                    </button>
                                </form>
                                <form action="/api/member/confirm-price" method="POST" class="flex-1">
                                    <input type="hidden" name="job_id" value="<%= job.id %>">
                                    <input type="hidden" name="action" value="reject">
                                    <button class="w-full bg-white border border-slate-200 text-slate-600 px-6 py-3 rounded-xl font-semibold hover:bg-slate-50 transition">
                                        ปฏิเสธ
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% } else if (job.status === 'In-Progress') { %>
                        <div class="mt-4 flex items-center text-blue-600 text-sm font-medium">
                            <svg class="w-5 h-5 mr-2 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            ลุงกำลังดำเนินการให้คุณอย่างสุดความสามารถ...
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </main>

</body>
</html>